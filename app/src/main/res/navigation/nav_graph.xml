<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/catListFragment">

    <fragment
        android:id="@+id/catListFragment"
        android:name="com.example.summerpractice.fragment.CatListFragment"
        android:label="Cat List" >

        <action
            android:id="@+id/action_to_details"
            app:destination="@id/catDetailFragment"
            app:popEnterAnim="@android:anim/fade_in"
            app:popExitAnim="@android:anim/fade_out"
            app:enterAnim="@android:anim/fade_in"
            app:exitAnim="@android:anim/fade_out" />

    </fragment>

    <fragment
        android:id="@+id/catDetailFragment"
        android:name="com.example.summerpractice.CatDetailFragment"
        android:label="Cat Detail">

        <argument
            android:name="catModel"
            app:argType="com.example.summerpractice.model.CatModel" />
    </fragment>
</navigation>
